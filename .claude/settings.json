{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node .claude/hooks/test-before-commit.mjs",
            "timeout": 170
          }
        ]
      }
    ]
  }
}
